# Environment Configuration Template
# Copy this to .env and fill in actual values
# DO NOT commit .env file to git!

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=cafe_shop

# Backend
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/cafe_shop
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me_secure_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=CHANGE_ME_TO_SECURE_BASE64_SECRET_MINIMUM_32_CHARS

# Frontend
REACT_APP_API_BASE_URL=http://localhost:8088/api

# Docker
DOCKER_NAMESPACE=your_dockerhub_username
